# SubroRecover AI Environment Configuration Template
# Copy this file to .env and supply your credentials

# Application Settings
APP_NAME=SubroRecover AI
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=subrorecover-super-secret-key-change-in-prod-2026

# Database Settings
# For PostgreSQL (Production):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/subro_recover
# For SQLite (Local Zero-Config Fallback):
DATABASE_URL=sqlite:///./subro_recover.db
DB_FALLBACK_TO_SQLITE=true

# AI & LLM Settings
# Optional: Provide Google Gemini API Key for live LLM execution.
# If omitted or left empty, SubroRecover AI operates in transparent local deterministic mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Backend & Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501

# ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_db
